# ==========================================================
# Configuración de Mensaje Seguro - Bot de Telegram
# ==========================================================
# Token de acceso obtenido desde BotFather en Telegram (NO compartir ni subir a git)
TELEGRAM_BOT_TOKEN=tu_token_aqui_obtenido_de_BotFather

# URL base donde corre la API FastAPI existente
API_URL=http://127.0.0.1:8000

# Tiempo máximo de espera para solicitudes a la API (en segundos)
API_TIMEOUT_SECONDS=10.0

# Longitud máxima de texto permitida para análisis (coincide con la API)
MAX_TEXT_LENGTH=5000

# ==========================================================
# Motor de decisión táctica - Nivel 2 (Laya, opcional)
# ==========================================================
# 0 para desactivar el Nivel 2 y usar siempre el árbitro heurístico local
LAYA_ENABLED=1
# Módulo Python del runtime local de decisión
LAYA_MODULE=laya
# Ruta local al modelo de decisión (vacío = valor por defecto del runtime)
LAYA_MODEL_PATH=
# Presupuesto de latencia del Nivel 2; si se supera, se usa el fallback heurístico
LAYA_TIMEOUT_MS=50

